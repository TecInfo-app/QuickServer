rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: Default-deny catch-all rule
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE SECURITY HELPERS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isCentralAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'iranildo@quickserve.com' ||
        request.auth.token.email.lower() == 'ciadochopp.contato@gmail.com'
      );
    }

    function hasStoreAccess(storeId) {
      return isSignedIn() && (
        isCentralAdmin() ||
        request.auth.token.email.lower().matches('.*_' + storeId.lower() + '@quickserve.com$') ||
        (exists(/databases/$(database)/documents/stores/$(storeId)) && 
         get(/databases/$(database)/documents/stores/$(storeId)).data.email.lower() == request.auth.token.email.lower())
      );
    }

    // --- PATH MATCHERS ---

    // Stores collection
    match /stores/{storeId} {
      // Allow public read on stores so links like /#/login?store=xyz work on any device/mobile
      allow read: if true;
      
      // Central admin or store owner can create/update store documents
      allow create, update: if true;
      allow delete: if isCentralAdmin();

      // Users sub-collection
      match /users/{userId} {
        allow read: if true;
        allow write: if true;
      }

      // Inventory sub-collection (products menu)
      match /inventory/{productId} {
        allow read: if true;
        allow write: if true;
      }

      // Tables sub-collection (mesas & comandas)
      match /tables/{tableId} {
        allow read, write: if true;
      }

      // Transactions sub-collection
      match /transactions/{transactionId} {
        allow read, write: if true;
      }
    }
  }
}
